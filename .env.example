# Yahoo Fantasy Sports API credentials
# Get these from https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID=your_client_id_here
YAHOO_CLIENT_SECRET=your_client_secret_here

# Robot League Baseball (find your league key via GET /api/leagues after auth)
ROBOT_LEAGUE_KEY=469.l.12479

# Optional second configured league for the UI/API allowlist
LHF_LEAGUE_KEY=

# Optional local saved team profiles for faster switching in the browser UI.
# Format: Label|league_key|team_key;Other Team|league_key|team_key
# Example:
# LOCAL_TEAM_PROFILES=Robot League|469.l.12479|469.l.12479.t.7;Second League|469.l.15622|469.l.15622.t.4
LOCAL_TEAM_PROFILES=

# Redirect URI - must exactly match what's configured in your Yahoo app
# For web app: http://localhost:8000/auth/callback (when running uvicorn on port 8000)
# For CLI: use ngrok (e.g. https://xxxx.ngrok-free.app) and paste the code manually
YAHOO_REDIRECT_URI=http://localhost:8000/auth/callback

# Optional daily lineup automation
# LINEUP_TEAM_KEY should be a full Yahoo team key like 469.l.12479.t.7
# It still enables the scheduler; when set, the scheduler can run all
# resolved local teams from LOCAL_TEAM_PROFILES or configured leagues.
LINEUP_TEAM_KEY=
LINEUP_LEAGUE_KEY=
# Comma-separated 24h run times in the scheduler timezone
LINEUP_SCHEDULE_TIMES=11:00,17:00
LINEUP_SCHEDULE_TZ=US/Eastern
LINEUP_AUTO_APPLY=false
LINEUP_WEIGHT_7D=0.6
LINEUP_WEIGHT_30D=0.4

# Optional email notifications for scheduled lineup automation
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
NOTIFY_EMAIL_TO=recipient@example.com
# Set true if you want an email even when no lineup changes are needed
NOTIFY_ON_NO_CHANGES=false
