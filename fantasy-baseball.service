[Unit]
Description=Fantasy Baseball FastAPI service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/fantasy_baseball
EnvironmentFile=/home/pi/fantasy_baseball/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/fantasy_baseball/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
